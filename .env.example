# Copy this file to .env and fill in real values. Never commit .env.
# NEXT STEP TO GO LIVE: none of these are read by the app yet — see README
# "Connecting Supabase" and "AI Assistant architecture" for how they'd be used.

# Supabase (safe to expose in frontend — protected by Row Level Security)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key — SERVER-SIDE ONLY. Never put this in frontend JS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI — SERVER-SIDE ONLY. Used by a serverless function (e.g. Vercel/Netlify
# function or Supabase Edge Function), never called directly from the browser.
OPENAI_API_KEY=your-openai-key

# Deployment
SITE_URL=https://your-marketing-os.vercel.app
